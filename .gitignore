# ─────────────────────────────────────────────────────────────────────────────
# kokoro-deutsch .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
downloads/
eggs/
parts/
sdist/
wheels/
*.egg
.installed.cfg
MANIFEST
*.so

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Linter / tool caches ───────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/
.hypothesis/
.pyre/
.pytype/

# ── Dataset (not redistributable — see README) ─────────────────────────────
dataset/

# ── Training data lists (derived from non-redistributable dataset) ──────────
training/train_list.txt
training/val_list.txt
training/vctk_*.txt
training/vctk_speakers.json
training/symbols.json
training/manifest.json
training/speakers.json
training/train.txt
training/val.txt
training/OOD.txt

# ── Training artifacts (large binary files) ─────────────────────────────────
training/kokoro_base.pth
training/mels/
training/f0/

# ── Training checkpoints and logs ───────────────────────────────────────────
StyleTTS2/logs/
StyleTTS2/Models/

# ── Test output (generated WAVs and converted models) ───────────────────────
test_output/
generated/
test/
af/

# ── Voicepacks (derived from non-redistributable data) ─────────────────────
voices/*.pt
voices/vctk_samples/
voices/vctk_stage1/
voices/vctk_best_stage1/

# ── Backup and temp files ───────────────────────────────────────────────────
*.bak
*.org
*.backup
*.swp
*.swo
*~
*.log
pip-log.txt
pip-delete-this-directory.txt

# ── Editor / IDE ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace
.ipynb_checkpoints/
.spyderproject
.spyproject
.ropeproject

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
